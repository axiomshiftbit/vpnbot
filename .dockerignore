# Only the snolc image uses the repository root as its build context.
# No runtime data, environment files, Git history or keys are sent to Docker.
*
!app/
!app/snolc/
!app/snolc/**
!scripts/
!scripts/protocol_service.py
!scripts/snolc_service.py
!dockerfile/
!dockerfile/snolc.dockerfile
!dockerfile/snolc-core.patch
!dockerfile/snolc-modules.patch
**/__pycache__/**
**/*.pyc
