# Allow only source inputs needed by root-context image builds.
# No runtime data, environment files, Git history or keys are sent to Docker.
*
!scripts/
!scripts/protocol_service.py
!scripts/hysteria_service.py
!dockerfile/
!dockerfile/go-*.sh
!dockerfile/go-sources.sha256
!dockerfile/build-xray.sh
**/__pycache__/**
**/*.pyc
