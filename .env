TZ=Europe/Samara
WGADDRESS=10.0.1.1/24
WG1ADDRESS=10.0.3.1/24
CKPORT=7443
STLSPORT=3443
TTPORT=2443
# TrustTunnel: пин на коммит, а не на master. Сборка тут самая дорогая (два
# Rust-бинаря), и с плавающей веткой два прогона ОДНОГО коммита репозитория
# давали разные образы — воспроизвести проблему было нельзя. Это master на
# 2026-08-07, то есть v1.0.41 + 9 коммитов: на тег не пинним, иначе откатились
# бы те 9 коммитов, на которых серверы уже работают.
TT_REF=aae4b79f5e470deac76928379c241040811b50f0
# renovate: datasource=docker depName=ghcr.io/telemt/telemt
TELEMT_VERSION=3.4.25
OVPNPORT=1194
OVPNPROTO=udp4
OVPNSUBNET=10.8.0.0/24
L2TPSUBNET=10.9.1.0/24
IKEV2SUBNET=10.9.2.0/24
# renovate: datasource=docker
IMAGE=alpine:3.18.2
# Тег образов ghcr.io/axiomshiftbit/vpnbot-*. dev — плавающий канал ветки dev,
# latest — ветки master. Для отката на конкретную сборку укажите sha-<commit>
# в override.env: он не отслеживается git и переживает `make reset`.
VPNBOT_TAG=dev
IP=
VER=
TELEGRAM_API=api.telegram.org
ENV=/root/.ashrc
# renovate: datasource=github-releases depName=XTLS/Xray-core
XRAY_VERSION=v26.7.28
# renovate: datasource=gitlab-tags depName=openconnect/ocserv
OCSERV_VERSION=1.5.0
# renovate: datasource=github-releases depName=amnezia-vpn/amneziawg-go
AWG_GO_VERSION=v3.0.20260805
# renovate: datasource=github-releases depName=amnezia-vpn/amneziawg-tools
AWG_TOOLS_VERSION=v3.0.20260805
# renovate: datasource=github-releases depName=ViRb3/wgcf
WGCF_VERSION=v2.2.32
# AdGuardHome. Без пина FROM тянул :latest, и на каждой пересборке в контейнер
# приезжала произвольная версия: конфиг /config/AdGuardHome.yaml мигрируется
# вперёд необратимо, поэтому даунгрейд после такого обновления невозможен.
# renovate: datasource=docker depName=adguard/adguardhome
ADGUARD_VERSION=v0.107.78
# hysteria: до пина FROM тянул :latest — версия менялась при каждой пересборке.
# renovate: datasource=docker depName=tobyxdd/hysteria
HYSTERIA_VERSION=v2.12.0
# naive (caddy + forwardproxy). CADDY_VERSION и FORWARDPROXY_VERSION меняются
# только парой: тег плагина = версия caddy с суффиксом -naive. Тег го-модулем
# не является (мажор 2 при пути без /v2) — сборка разворачивает его в коммит,
# см. dockerfile/naive.dockerfile.
CADDY_GO_VERSION=1.25
# renovate: datasource=github-releases depName=caddyserver/xcaddy
XCADDY_VERSION=v0.4.5
# CADDY_VERSION и FORWARDPROXY_VERSION намеренно БЕЗ аннотации renovate:
# бот обновил бы одну строку из двух, а рассинхронизированная пара ломается уже
# в рантайме, а не на сборке. Обновляем вручную и вместе.
CADDY_VERSION=v2.11.2
FORWARDPROXY_VERSION=v2.11.2-naive
# shadowsocks + плагины. Пустое значение = последний релиз с github.
# renovate: datasource=github-releases depName=shadowsocks/shadowsocks-rust
SS_RUST_VERSION=v1.24.0
# renovate: datasource=github-releases depName=teddysun/v2ray-plugin
V2RAY_PLUGIN_VERSION=v5.49.0
# renovate: datasource=github-releases depName=cbeuw/Cloak
CLOAK_VERSION=v2.12.0
# renovate: datasource=github-releases depName=IrineSistiana/simple-tls
SIMPLE_TLS_VERSION=v0.8.0
