TZ=Europe/Moscow
WGADDRESS=10.0.1.1/24
WG1ADDRESS=10.0.3.1/24
CKPORT=7443
STLSPORT=3443
TTPORT=2443
# TrustTunnel: стабильный релиз v1.1.0 включает прежний пин и исправления
# UDP/IPv6. Тег также нужен upstream для определения версии при сборке.
TT_REF=v1.1.0
# dnstt: у upstream был просто `git clone` без ветки и тега, то есть каждая
# пересборка брала текущий master и два образа с одним тегом могли нести разный
# dnstt. Пин по коммиту, а не по тегу: репозиторий на bamsoftware отдаётся по
# dumb http, теги там читаются, но fetch по SHA невозможен — dockerfile клонирует
# целиком и делает checkout. Это коммит тега v1.20260501.0, на нём же стоит
# master, так что пин ничего не откатывает. Renovate его не ведёт (как и TT_REF):
# обновлять вручную — git ls-remote https://www.bamsoftware.com/git/dnstt.git
DNSTT_REF=0c5c52a57d899c05428c116898941761a2ed83c2
# WARP SOCKS5 TCP/UDP использует XRAY_VERSION: те же проверенные исходники,
# закреплённый Go, сканирование и нативные тесты всего комплекта.
# renovate: datasource=docker depName=ghcr.io/telemt/telemt
TELEMT_VERSION=3.5.14
# OpenVPN и Easy-RSA ставятся из официальных релизов с проверкой SHA256:
# пакеты Alpine отстают. Сумма архива OpenVPN — в dockerfile/sources.sha256.
OPENVPN_VERSION=2.7.8
EASYRSA_VERSION=3.2.7
EASYRSA_SHA256=308743bc9fe871b902d47dbe98d749daff3a05b27531684f02625ce7208d4598
OVPNPORT=1194
OVPNPROTO=udp4
OVPNSUBNET=10.8.0.0/24
L2TPSUBNET=10.9.1.0/24
IKEV2SUBNET=10.9.2.0/24
# Базовый Alpine для образов с аргументом image, включая php/service,
# WG/WARP, OpenConnect, OpenVPN и IPsec. Репозитории edge не используются.
# PHP 8.5 обслуживает FreeUnit (freeunit/freeunit-php85 из community).
# Он сохраняет unitd, unix control API и config/unit.json. Следующий minor
# Alpine требует отдельной проверки совместимости; патчи 3.24 разрешены.
# renovate: datasource=docker
IMAGE=alpine:3.24
# nginx для контейнеров ng и upstream. Чтобы не ждать обновления пакета Alpine,
# актуальный стабильный бинарь собирается из исходников
# (см. dockerfile/nginx.dockerfile). Держим СТАБИЛЬНУЮ ветку: у nginx чётный
# минор (1.28, 1.30, 1.32) — stable, нечётный (1.29, 1.31) — mainline.
# Renovate сам подтягивает только патчи 1.30.x; переход на следующую стабильную
# ветку требует подтверждения в dependency dashboard (см. renovate.json) —
# именно на смене ветки приезжают изменения поведения, а не на патчах.
# versioning=docker обязателен. Без него сработал бы дефолт менеджера
# (semver-coerced), а он приводит суффиксные теги docker hub к голой версии:
# «1.31.3-alpine» стало бы кандидатом на обновление, уехало бы в NGINX_VERSION
# и сборка упала бы на 404 — тарбола nginx-1.31.3-alpine.tar.gz не существует.
# Docker-версионирование держит поток тегов без суффикса отдельно.
# renovate: datasource=docker depName=nginx versioning=docker
NGINX_VERSION=1.30.6
# Канал образов: latest для master, dev для dev. Новые выпуски выбираются
# целиком через update/image-bundle.json с digest всех 18 образов.
# Старые sha-<commit> в override.env поддерживаются для ручного отката
# вместе с совместимым кодом; новые выпуски имеют теги release-<run>-<attempt>.
#
# ПРАВИЛО ПАРНОСТИ: канал образов обязан совпадать с веткой кода, потому что
# dockerfile и использующий его PHP лежат в ОДНОМ коммите. Пример: 2540e65
# добавил libqrencode-tools в php.dockerfile и одновременно код sendQr(),
# который на этот бинарь рассчитывает — с образом от другой ветки он получил бы
# новый код без нового бинаря.
#
#   боевая машина:   ветка master + VPNBOT_TAG=latest   <- дефолт, менять нечего
#   обкатка:         ветка dev    + VPNBOT_TAG=dev
#
# Обе настройки задаются НА МАШИНЕ и не отслеживаются git, поэтому переживают
# обновление и `git clean -fd` (update/* и override.env — в .gitignore):
#   update/branch   — ветка кода, читает update/update.sh
#   override.env    — VPNBOT_TAG, подключается вторым и перекрывает этот файл
#
# Руками задаётся только ПЕРВАЯ: ветку выбирают кнопкой в боте
# (Menu -> config -> update -> «<ветка> => <ветка>»), а VPNBOT_TAG под неё
# приводит scripts/sync_image_tag.sh — его зовёт update/update.sh после
# checkout и до `make start`. Menu -> update показывает обе строки (branch и
# images) вместе, так что разъезд пары виден до нажатия «обновить».
# Ручная правка КАНАЛЬНОГО тега (latest/dev) в override.env переживёт ровно до
# следующего обновления/рестарта: правило парности сильнее. Пин на конкретную
# сборку (sha-<commit>) синхронизатор не трогает — это осознанный откат, и
# снимается он тоже руками, удалением строки из override.env.
#
# Дефолт здесь — latest, под дефолтную ветку репозитория (master). Раньше стоял
# dev, и свежий клон получал перекрёстную пару: код master, образы dev.
VPNBOT_TAG=latest
IP=
VER=
TELEGRAM_API=api.telegram.org
# Прокси для запросов к Bot API, если исходящие к Telegram зарезаны.
# Схема задаётся прямо в значении, например socks5h://wp:1080 (WARP из этого же
# стека). Пусто — идём напрямую.
TELEGRAM_PROXY=
# Веб-панель (app/panel). Слушатель unit виден всей docker-сети, поэтому панель
# пускает только с loopback и со шлюза своей сети — то есть с самого сервера
# (проброшенный порт или ssh -L). Список расширяют адреса/CIDR через пробел или
# запятую, '*' снимает проверку целиком (не надо).
PANEL_TRUSTED=
# Имена, допустимые в заголовке Host (защита от DNS rebinding). localhost и
# любой literal-IP разрешены всегда; сюда — своё имя, если ходите не по IP.
PANEL_HOSTS=
ENV=/root/.ashrc
# REALITY в 26.9.9+ требует X25519MLKEM768. Бот настраивает Xray/mihomo,
# а несовместимые подписки sing-box отклоняет с объяснением. Для sing-box
# используйте WebSocket/TLS или Trojan/gRPC без VLESS Encryption (см. readme).
# Следующие обновления ядра требуют проверки клиентов; потолок в renovate.json.
# renovate: datasource=github-releases depName=XTLS/Xray-core
XRAY_VERSION=v26.10.21
# Дополнительные версии для выбора в меню Xray → Ядро/версия.
# Пины меняются при пересборке xr; пустой слот не включается в образ.
# Слоты 2 и 3 — 26.9.30 и 26.7.28: запасные ядра со старым поведением REALITY
# (маска без ALPN) и XDRIVE (без обязательного Mux). 26.10.10 и 26.10.17 XTLS
# отозвал 2026-10-21: встроенные корневые сертификаты со скомпрометированными
# ключами, теги удалены. Клиентам со старым рукопожатием REALITY (sing-box,
# ios/edge/qq) — 26.7.28 или форк без «Требовать ML-KEM».
XRAY_VERSION_2=v26.9.30
XRAY_VERSION_3=v26.7.28
# Форк-ядро Jolymmiles/Xray-core: то же ядро плюс sing-mux (smux/h2mux), TCP
# Brutal и полное распознавание BitTorrent (uTP, DHT/KRPC, UDP-трекеры — у
# апстрима из них рабочего нет ни одного). Живёт в образе рядом с апстримом
# (/usr/bin/xray-smux), активное ядро переключает бот кнопкой «core» —
# пересборка для этого не нужна.
# С 26.8.25 форк тегает релизы как year.month.day-HHMM (UTC): суффикс — не
# pre-release, а время сборки, и тег отдаётся в /releases/tags как есть.
# 26.10.5 включает апстрим 26.9.30 и собирается с тегом http2legacy (см.
# dockerfile/xray.dockerfile). REALITY форка живёт в его дереве и, в отличие
# от апстрима, принимает клиентов без X25519MLKEM768 (sing-box).
# renovate: datasource=github-releases depName=Jolymmiles/Xray-core
XRAY_FORK_VERSION=v26.10.28-1202
# renovate: datasource=gitlab-tags depName=openconnect/ocserv
OCSERV_VERSION=1.6.0
# renovate: datasource=github-releases depName=amnezia-vpn/amneziawg-go
AWG_GO_VERSION=v3.1.20260828
# renovate: datasource=github-releases depName=amnezia-vpn/amneziawg-tools
AWG_TOOLS_VERSION=v3.1.20260812
# renovate: datasource=github-releases depName=ViRb3/wgcf
WGCF_VERSION=v2.3.1

# Утилиты внутри php-контейнера. Раньше версии были зашиты прямо в
# dockerfile/php.dockerfile, поэтому custom-manager renovate (он читает
# аннотации только в .env) их не видел и обновить их было некому.
# dnslookup — диагностика DNS из меню бота.
# renovate: datasource=github-releases depName=ameshkov/dnslookup
DNSLOOKUP_VERSION=v1.12.0
# sing-box в php компилирует rule-set'ы: createSrs()
# зовёт `sing-box rule-set compile` и отдаёт .srs клиенту. Формат srs v1 не
# менялся с 1.12 по 1.14 (вывод байт-в-байт), так что мажор можно двигать
# независимо от клиентских ядер. PHP-утилиты собираются статически с CGO=0
# из закреплённых исходников и исправленных Go-зависимостей для Alpine.
# Узлы выхода также используют sing-box для чтения .srs и mihomo
# для преобразования .mrs в записи маршрутизации Xray.
# renovate: datasource=github-releases depName=SagerNet/sing-box
SINGBOX_VERSION=v1.14.4
# renovate: datasource=github-releases depName=MetaCubeX/mihomo
MIHOMO_VERSION=v1.19.33

# Protocol cores and verified upstream archives. Use scripts/update_protocol_versions.py
# to change a version together with its checksums, then rebuild the affected images.
SINGBOX_SHA256=8f7c5f0651238850d96a0e488e5473cd77ec1a0098f63942e943f475a12057ca
SINGBOX_SOURCE_SHA256=0958ccd23b1ea9a141d715d15478b1e040fd04bcca19d8ff5529636b1b753e18
MIHOMO_SHA256=132f6f3edf9a65e62f04853aed3358472e0b2b7666daa8419edfa2ddf5bb6323
MIHOMO_SOURCE_SHA256=e7c596b37ff27ec487d19b1920f73e0c97a78067ea35766530ee9659ade72711
MIERU_VERSION=v3.39.0
MIERU_SOURCE_SHA256=434198ea0558bc440379e9a0a97f6904ba8dd6b213dd6fb9d578388eba7d2f12
# Все слоты xr собираются этим Go. 1.27.3 отличается от 1.27.2 только запретом
# скомпрометированных промежуточных сертификатов в crypto/x509 (CVE-2026-111943);
# crypto/tls не менялся. Падение Vision из #7176 вызывала новая библиотека
# REALITY, а не Go: старые ядра закрепляют прежнюю.
PROTOCOL_GO_VERSION=1.27.3
# AdGuardHome. Без пина FROM тянул :latest, и на каждой пересборке в контейнер
# приезжала произвольная версия: конфиг /config/AdGuardHome.yaml мигрируется
# вперёд необратимо, поэтому даунгрейд после такого обновления невозможен.
# renovate: datasource=docker depName=adguard/adguardhome
ADGUARD_VERSION=v0.107.79
# hysteria: до пина FROM тянул :latest — версия менялась при каждой пересборке.
# renovate: datasource=docker depName=tobyxdd/hysteria
HYSTERIA_VERSION=v2.13.0
# NaiveProxy: Caddy и плагин имеют независимые теги. Комбинация допускается
# только после нативного теста, включая аутентификацию и длительные соединения.
CADDY_GO_VERSION=1.27.3
# renovate: datasource=github-releases depName=caddyserver/xcaddy
XCADDY_VERSION=v0.4.7
# Caddy/forwardproxy обновляем вместе с проверкой совместимости на временном VPN-стенде CI.
CADDY_VERSION=v2.11.7
FORWARDPROXY_VERSION=v2.11.7-naive2
# Shadowsocks + плагины. Go-исходники дополнительно закреплены SHA-256
# в dockerfile/go-sources.sha256; новый тег требует обновления этой суммы.
# renovate: datasource=github-releases depName=shadowsocks/shadowsocks-rust
SS_RUST_VERSION=v1.25.0
# renovate: datasource=github-releases depName=teddysun/v2ray-plugin
V2RAY_PLUGIN_VERSION=v5.49.0
# renovate: datasource=github-releases depName=cbeuw/Cloak
CLOAK_VERSION=v2.12.0
# renovate: datasource=github-releases depName=IrineSistiana/simple-tls
SIMPLE_TLS_VERSION=v0.8.0

# Legacy defaults; protocol_modules.py selects enabled services at runtime.
COMPOSE_PROFILES=oc,ovpn,ipsec

# Отдельное ядро MASQUE с изоляцией клиентов; основной xr не зависит от него.
MASQUE_GO_VERSION=1.27.3
MASQUE_XRAY_VERSION=v26.10.21
MASQUE_SOURCE_SHA256=44ef4874529a03848c90f1fdcfb763350fbc5f1de741ec90e0024d651df25650
