/app/config.php
/certs/*
!/certs/.gitkeep
# обмен с acme-window (scripts/acme_window.py), создаётся на сервере
/acme/
/logs/*
!/logs/.gitkeep
/ssh/*
!/ssh/.gitkeep
/app/zaprelists/*
!/app/zaprelists/.gitkeep
/sftp-config.json
/tg.pyr
# ВНИМАНИЕ: wg0.conf/wg1.conf (как и clients*.json, pac.json, xray.json)
# ОТСЛЕЖИВАЮТСЯ git'ом как пустые шаблоны — на уже добавленные файлы .gitignore
# не действует, и эти строки влияют только на свежий клон. Правки на сервере
# видны как «modified». update/update.sh сохраняет рабочие данные отдельно
# перед очисткой и возвращает их ДО запуска контейнеров. Раньше здесь был
# только wg0.conf, из-за чего казалось, что второй
# инстанс чем-то отличается: не отличается.
/config/wg0.conf
/config/wg1.conf
# эфемерная карта «сообщение → wg-инстанс» (см. wgMsgFile в bot.php)
/config/wg_msg.json
/config/hwid.json
/config/vpnbot.sqlite*
/config/xray-core-probe.json
/config/ipv6-egress.json
# Рантайм бота на сервере (проверено по git status на рабочих серверах 2026-10-31):
# секреты — закрытый ключ узла DNSTT, пользователи Hysteria, Cloak, ShadowTLS и
# TeleMT; личные данные — журналы подключений, онлайн, статистика, кеши.
/config/dnstt/
/config/hysteria/
/config/telemt/*
!/config/telemt/.gitkeep
/config/ckusers.json
/config/stlsserver.json
/config/connlog.json
/config/wgconnlog.json
/config/online.json
/config/geoip.json
/config/extsub.cache
/config/exit-nodes.status.json
/config/relay.health
/config/relay.dns.json
/config/telemtactivity.json
/config/xray.stats
/config/*.lock
# Адрес Bot API из бота/CLI (TelegramApi): git clean в update.sh не должен
# удалять его при обновлении.
/config/telegram_api
/config/telegram_api.*.tmp
/config/.*.lock
# лента веб-панели, загруженные/отданные файлы и хеш пароля-заглушки
/config/panel/
/config/protocols/
/config/protocol-services*.json
/config/protocol-services*.lock
/config/upstream.lock
/config/openvpn/*
!/config/openvpn/.gitkeep
# рантайм ipsec: PSK, приватные ключи CA/сервера, chap-secrets, юзеры —
# никогда не коммитим
/config/ipsec/*
!/config/ipsec/.gitkeep
/todo.todo
/app/zapretlists/*
!/app/zapretlists/.gitkeep
.vscode/
.idea/
mirror/.env
update/*
!update/update.sh

override.env
override.html
override.php
docker-compose.override.yml
backup.json
app/webapp/override/
# Пароль фейк-страницы (auth_basic корня): хеш инсталляции, не код.
app/webapp/.htpasswd
.rest

subscription.php
location.conf
override.conf
i18n.override.php

# не заливаем в релиз-репозиторий (host-специфичные nft-конфиги)
/post-receive
/nft_conf/
/nft/
nftables.conf
.venv/
.codex/
.claude/
.agents/
# отчёты аудита — только локально, не в репозитории
/AUDIT-*.md
/audit/
/audits/
# локальные копии шаблонов подписок sing-box: правятся здесь, а в панель
# заливаются вручную (singtemplates в pac.json). В репозитории им делать
# нечего — правило было только в .git/info/exclude, то есть жило в одном
# клоне и в любом другом ничего не защищало.
/sing-box/

__pycache__/
