{
  "noise-server": {
    "mode": "server",
    "private_key_file": "../../keys/noise-private.hex"
  },
  "noise-client": {
    "mode": "client",
    "server_public_key_file": "../../keys/noise-public.hex"
  },
  "socks5-client": {
    "listen": "127.0.0.1:1080",
    "max_connections": 16,
    "max_udp_associations": 8,
    "max_request_bytes": 1024,
    "reject_fragments": true
  }
}
