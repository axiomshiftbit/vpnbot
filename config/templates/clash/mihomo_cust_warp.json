  "rules": [
    [
      "AND,((NETWORK,udp),(DST-PORT,135)),REJECT"
    ],
    [
      "AND,((NETWORK,udp),(DST-PORT,137)),REJECT"
    ],
    [
      "AND,((NETWORK,udp),(DST-PORT,138)),REJECT"
    ],
    [
      "AND,((NETWORK,udp),(DST-PORT,139)),REJECT"
    ],
    {
      "type": "RULE-SET",
      "list": "~block~",
      "action": "REJECT",
      "interval": 60,
      "behavior": "classical",
      "name": "block"
    },
    [
      "RULE-SET,adlist@domain,REJECT"
    ],
    [
      "AND,((DST-PORT,443),(NETWORK,UDP)),REJECT"
    ],
    [
      "IP-CIDR,127.0.0.0/8,DIRECT,no-resolve"
    ],
    [
      "IP-CIDR,10.0.0.0/8,DIRECT,no-resolve"
    ],
    [
      "IP-CIDR,172.16.0.0/12,DIRECT,no-resolve"
    ],
    [
      "IP-CIDR,192.168.0.0/16,DIRECT,no-resolve"
    ],
    [
      "IP-CIDR,169.254.0.0/16,DIRECT,no-resolve"
    ],
    [
      "IP-CIDR,100.64.0.0/10,DIRECT,no-resolve"
    ],
    [
      "IP-CIDR,224.0.0.0/4,DIRECT,no-resolve"
    ],
    [
      "IP-CIDR,255.255.255.255/32,DIRECT,no-resolve"
    ],
    [
      "DOMAIN-REGEX,^[^.]+$,DIRECT"
    ],
    [
      "DOMAIN-SUFFIX,local,DIRECT"
    ],
    [
      "DOMAIN-SUFFIX,lan,DIRECT"
    ],
    [
      "DOMAIN-SUFFIX,home.arpa,DIRECT"
    ],
    [
      "DOMAIN-REGEX,.*,full warp"
    ],
    [
      "IP-CIDR,0.0.0.0/0,full warp,no-resolve"
    ],
    [
      "DOMAIN-REGEX,.*,global"
    ],
    [
      "IP-CIDR,0.0.0.0/0,global,no-resolve"
    ],
    {
      "type": "RULE-SET",
      "list": "~process~",
      "action": "PROXY",
      "interval": 60,
      "behavior": "classical",
      "name": "process"
    },
