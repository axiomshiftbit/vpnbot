{
  "tcp-concurrent": true,
  "enable-process": true,
  "find-process-mode": "strict",
  "mode": "rule",
  "log-level": "info",
  "ipv6": false,
  "keep-alive-interval": 60,
  "unified-delay": true,
  "profile": {
    "store-selected": true,
    "store-fake-ip": true
  },
  "sniffer": {
    "enable": true,
    "force-dns-mapping": true,
    "parse-pure-ip": true,
    "sniff": {
      "HTTP": {
        "ports": [
          80,
          "8080-8880"
        ],
        "override-destination": true
      },
      "TLS": {
        "ports": [
          443,
          8443
        ]
      },
      "QUIC": {
        "ports": [
          443,
          8443
        ]
      }
    },
    "skip-dst-address": [
      "rule-set:telegram@ipcidr"
    ]
  },
  "tun": {
    "enable": true,
    "stack": "mixed",
    "dns-hijack": [
      "any:53"
    ],
    "auto-route": true,
    "auto-detect-interface": true,
    "strict-route": true
  },
  "dns": {
    "enable": true,
    "prefer-h3": false,
    "use-hosts": true,
    "use-system-hosts": true,
    "respect-rules": true,
    "ipv6": false,
    "enhanced-mode": "redir-host",
    "default-nameserver": [
      "1.1.1.1",
      "8.8.8.8"
    ],
    "proxy-server-nameserver": [
      "https://77.88.8.8/dns-query#DIRECT",
      "tls://77.88.8.8#DIRECT"
    ],
    "direct-nameserver": [
      "https://77.88.8.8/dns-query#DIRECT",
      "tls://77.88.8.8#DIRECT"
    ],
    "direct-nameserver-follow-policy": false,
    "nameserver": [
      "https://1.1.1.1/dns-query#Заблок. сервисы",
      "https://8.8.8.8/dns-query#Заблок. сервисы"
    ]
  },
  "geodata-mode": true,
  "geo-auto-update": true,
  "geo-update-interval": 24,
  "geox-url": {
    "geosite": "https://github.com/jameszeroX/zkeen-domains/releases/latest/download/zkeen.dat",
    "geoip": "https://github.com/jameszeroX/zkeen-ip/releases/latest/download/zkeenip.dat"
  },
  "proxies": [
    {
      "name": "~outbound~",
      "type": "vless",
      "server": "~domain~",
      "port": 443,
      "uuid": "~uid~",
      "network": "tcp",
      "flow": "xtls-rprx-vision",
      "udp": true,
      "tls": true,
      "reality-opts": {
        "public-key": "~public_key~",
        "short-id": "~short_id~"
      },
      "servername": "~server_name~",
      "client-fingerprint": "~fingerprint~"
    },
    {
      "name": "warpSOCKS5",
      "type": "socks5",
      "server": "10.10.0.13",
      "port": 1080,
      "udp": true,
      "dialer-proxy": "warp-dialer"
    }
  ],
  "proxy-groups": [
    {
      "name": "PROXY",
      "type": "select",
      "proxies": [
        "~outbound~"
      ]
    },
    {
      "name": "Заблок. сервисы",
      "type": "select",
      "icon": "https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Reject.png",
      "include-all": true,
      "exclude-filter": "dns-out|warpSOCKS5"
    },
    {
      "name": "global",
      "type": "select",
      "icon": "https://www.svgrepo.com/show/396567/globe-with-meridians.svg",
      "proxies": [
        "PASS",
        "Заблок. сервисы",
        "DIRECT"
      ]
    },
    {
      "name": "full warp",
      "type": "select",
      "icon": "https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Cloudflare.png",
      "proxies": [
        "PASS",
        "warpSOCKS5",
        "DIRECT"
      ]
    },
    {
      "name": "warp-dialer",
      "type": "select",
      "include-all": true,
      "exclude-filter": "warpSOCKS5|dns-out"
