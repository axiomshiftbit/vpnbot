{
	"listeners": {
		"*:80": {
			"pass": "applications/php"
		},
		"*:8090": {
			"pass": "applications/php"
		}
	},
	"applications": {
		"php": {
			"type": "php",
			"root": "/app",
			"script": "index.php",
			"user": "root",
			"group": "root",
			"processes": {
				"max": 6,
				"spare": 2,
				"idle_timeout": 60
			}
		}
	},
	"access_log": "/logs/unit_access"
}
