{
	"listeners": {
		"*:80": {
			"pass": "applications/php"
		},
		"*:8090": {
			"pass": "applications/panel"
		}
	},
	"applications": {
		"php": {
			"type": "php",
			"root": "/app",
			"script": "index.php",
			"user": "root",
			"group": "root",
			"processes": {
				"max": 6,
				"spare": 2,
				"idle_timeout": 60
			}
		},
		"panel": {
			"type": "php",
			"root": "/app",
			"script": "panel/entry.php",
			"user": "root",
			"group": "root",
			"processes": {
				"max": 4,
				"spare": 1,
				"idle_timeout": 60
			}
		}
	},
	"access_log": {
		"path": "/logs/unit_access",
		"format": "$remote_addr - - [$time_local] \"$method $uri\" $status $body_bytes_sent"
	}
}
