+import { render } from '@solidjs/testing-library';
+import { afterEach, expect, it, vi } from 'vitest';
+import { customFetch } from 'panel/api/customFetch';
+import { Form } from 'panel/login/Login/Form';
+
+afterEach(() => {
+    vi.unstubAllGlobals();
+    history.replaceState(null, '', '/');
+});
+
+it.each(['/', '/panel-test/'])('keeps password recovery under %s', (prefix) => {
+    history.replaceState(null, '', prefix + 'login.html');
+    const { container } = render(() => <Form onSubmit={() => {}} />);
+    const link = container.querySelector<HTMLAnchorElement>('a[href*="forgot_password"]');
+    expect(link?.pathname).toBe(prefix + 'forgot_password.html');
+});
+
+it.each(['/', '/panel-test/'])('reports an invalid password under %s', async (prefix) => {
+    history.replaceState(null, '', prefix + 'login.html');
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(new Response('', { status: 403 })));
+    await expect(customFetch('control/login', { method: 'POST' })).rejects.toThrow('403');
+});
