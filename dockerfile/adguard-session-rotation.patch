+// credentialProof binds the record to this login, token and password generation.
+func credentialProof(u *User, token, record []byte) []byte {
+	var key []byte
+	if u.Password != nil {
+		key = u.Password.Hash()
+	}
+	mac := hmac.New(sha256.New, key)
+	mac.Write(token)
+	mac.Write(record)
+	return mac.Sum(nil)
+}
