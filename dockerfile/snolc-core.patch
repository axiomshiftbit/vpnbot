+    fn vpnbot_regression_datagram_waits_for_flush_without_duplicate_frames() {
+        struct BufferedStream {
+            pending: Vec<u8>,
+            delivered: Vec<u8>,
+            flush_ready: bool,
+        }
+        impl AsyncRead for BufferedStream {
+            fn poll_read(self: Pin<&mut Self>, _: &mut Context<'_>, _: &mut [u8]) -> Poll<io::Result<usize>> {
+                Poll::Pending
+            }
+        }
+        impl AsyncWrite for BufferedStream {
+            fn poll_write(mut self: Pin<&mut Self>, _: &mut Context<'_>, input: &[u8]) -> Poll<io::Result<usize>> {
+                self.pending.extend_from_slice(input);
+                Poll::Ready(Ok(input.len()))
+            }
+            fn poll_flush(mut self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+                if !self.flush_ready {
+                    self.flush_ready = true;
+                    return Poll::Pending;
+                }
+                let pending = std::mem::take(&mut self.pending);
+                self.delivered.extend_from_slice(&pending);
+                self.flush_ready = false;
+                Poll::Ready(Ok(()))
+            }
+            fn poll_close(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+                Poll::Ready(Ok(()))
+            }
+        }
+        let mut io = MuxDatagramIo::new(BufferedStream {
+            pending: Vec::new(), delivered: Vec::new(), flush_ready: false,
