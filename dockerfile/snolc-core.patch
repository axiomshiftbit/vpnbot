+#[cfg(test)]
+mod vpnbot_regressions {
+    use super::*;
+
+    #[test]
+    fn idle_polling_is_bounded_and_transfer_resumes_without_a_delay() {
+        let mut backoff = IdleBackoff::default();
+        let now = Instant::now();
+        let idle_time: Duration = (0..100).map(|_| backoff.next(false, now)).sum();
+        assert!(idle_time >= Duration::from_millis(950));
+        assert_eq!(backoff.next(false, now), Duration::from_millis(10));
+        for _ in 0..100 {
+            assert_eq!(backoff.next(true, now), Duration::ZERO);
+        }
+        assert_eq!(backoff.next(false, now + Duration::from_millis(49)), Duration::from_micros(100));
+        assert_eq!(backoff.next(false, now + Duration::from_millis(50)), Duration::from_millis(1));
+        for _ in 0..100 {
+            assert!(backoff.next(false, now + Duration::from_secs(1)) <= Duration::from_millis(10));
+        }
+        assert_eq!(backoff.next(false, now + Duration::from_secs(1)), Duration::from_millis(10));
+    }
+
