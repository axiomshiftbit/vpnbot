+#[cfg(test)]
+mod vpnbot_regressions {
+    use super::*;
+    use std::task::Waker;
+
+    #[test]
+    fn closed_udp_control_releases_all_destination_flows() {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let client = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (control, _) = listener.accept().unwrap();
+        let socket = UdpSocket::bind("127.0.0.1:0").unwrap();
+        socket.set_nonblocking(true).unwrap();
+        let destination = Address::Ipv4(Ipv4Addr::LOCALHOST);
+        let flow = UdpClientFlow::new(socket.try_clone().unwrap(), socket.local_addr().unwrap(), destination.clone(), 53, vec![1]).unwrap();
+        let mut state = State {
+            listen: listener.local_addr().unwrap(),
+            options: Options { listen: "127.0.0.1:1080".into(), max_connections: 16, max_udp_associations: 8, max_request_bytes: 1024, reject_fragments: true },
+            clients: vec![], flows: HashMap::new(), next_flow: 2,
+            associations: vec![UdpAssociation { control: ClientConnection::new(control).unwrap(), socket, client: None,
+                destinations: HashMap::from([((destination, 53), 1)]), receive_buffer: vec![0; 1024] }],
+            udp_flows: HashMap::from([(1, flow)]),
+        };
+        client.shutdown(Shutdown::Both).unwrap();
+        poll_udp_associations(&mut state, &mut Context::from_waker(Waker::noop()));
+        assert!(state.associations.is_empty());
+        assert!(state.udp_flows.is_empty());
+    }
