+#[cfg(test)]
+mod metrics_http1_tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn metrics_without_public_http1() {
+        let mut settings = Settings::default();
+        settings.listen_protocols.http1 = None;
+        let settings = Arc::new(settings);
+        let (io, _peer) = tokio::io::duplex(1024);
+        let codec = Http1Codec::new(settings.clone(), io, log_utils::IdChain::empty());
+        assert_eq!(codec.upload_buffer_size,
+            crate::settings::Http1Settings::default_upload_buffer_size());
+        assert!(settings.listen_protocols.http1.is_none());
+    }
+}
