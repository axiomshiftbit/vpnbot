+// tcpRelay preserves EOF in one direction while the other still carries a
+// response. Closing both sockets after the first Copy truncates half-closed
+// requests; all early dial failures must also close the accepted connection.
+func tcpRelay(left net.Conn, right net.Conn) {
+	defer left.Close()
+	defer right.Close()
+	var finished sync.WaitGroup
+	finished.Add(2)
+	copyOne := func(from net.Conn, to net.Conn) {
+		defer finished.Done()
+		if _, err := io.Copy(to, from); err != nil {
+			_ = left.Close()
+			_ = right.Close()
+		} else if writer, ok := to.(interface{ CloseWrite() error }); ok {
+			_ = writer.CloseWrite()
+		} else {
+			_ = to.Close()
+		}
+	}
+	go copyOne(left, right)
+	go copyOne(right, left)
+	finished.Wait()
+}
