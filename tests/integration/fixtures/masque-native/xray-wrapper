#!/usr/bin/env python3
import os,sys,json
from pathlib import Path
args=sys.argv[1:]
if Path('/lab/fail-stats').exists() and args[:2]==['api','statsquery']:sys.exit(1)
if args and args[0]=='run' and '-config' in args:
 p=Path(args[args.index('-config')+1]);conf=json.loads(p.read_text())
 if conf.get('_auditFailLaunch') and p.name=='config.json' and '-test' not in args:sys.exit(1)
os.execv('/lab/xray-masque',['/lab/xray-masque']+args)
